function setup() {
  createCanvas(700, 700);

  //white background
  background(112,41,99);

   //orange line
  stroke(255, 205, 155);
  line(0, 500, 3000, 300);

   //orange line
  stroke(46,139,87);
  line(0, 600, 8700, 300);

   //orange line
  stroke(46,139,87);
  line(0, 300, 8700, 300);

  //orange line
  stroke(46,139,87);
  line(0, 300, 8700, 300);

   //orange line
  stroke(46,139,87);
  line(0, 100, 8700, 300);

   //orange line
  stroke(46,139,87);
  line(0, 200, 8700, 300);

   //orange line
  stroke(46,139,87);
  line(0, 400, 8700, 300);

  //turn off default black outline on shapes
  noStroke();

  //red rectangle
  fill(255, 0, 0);
  rect(125, 100, 50, 100);

  //green quadrilateral
  fill(0, 255, 0);
  quad(300, 100, 400, 125, 400, 200, 300, 175);

