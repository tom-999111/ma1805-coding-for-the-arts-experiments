  fill(150, 105, 25);
  circle(430, 330, 100);

  //brown circle eye centre 2
  fill(72, 60, 50);
  circle(430, 330, 35);

  //ear 1
  fill(149,69,53)
  arc(190, 280, 100, 100,HALF_PI,TWO_PI);

  //ear 1 small
  fill(27,18,18)
  arc(190, 280, 70, 90,HALF_PI,TWO_PI);

    //ear 2
  fill(149,69,53)
  arc(500, 270, 100, 100, 280, 800,HALF_PI,TWO_PI);

   //ear 2 small
  fill(27,18,18)
